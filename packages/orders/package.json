{
  "name": "@northcinder/orders",
  "version": "0.2.0",
  "description": "NorthCinder local order graph with deterministic mail parsing, fail-closed unattended IMAP, explicit local import, buyer-confirmed outcomes, and notify-only reminders",
  "license": "MIT",
  "type": "module",
  "engines": { "node": ">=20" },
  "keywords": ["northcinder", "orders", "shopping"],
  "publishConfig": { "access": "public" },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "!dist/**/*.map"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@northcinder/checkout": "workspace:*",
    "@northcinder/protocol": "workspace:*",
    "@northcinder/watches": "workspace:*",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@types/node": "^20.17.0",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
