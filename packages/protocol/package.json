{
  "name": "@northcinder/protocol",
  "version": "0.2.1",
  "description": "NorthCinder shared protocol: Zod schemas, adapter SDK, and adapter conformance harness",
  "license": "MIT",
  "type": "module",
  "engines": { "node": ">=20" },
  "keywords": ["northcinder", "protocol", "mcp", "neutral-ranking"],
  "publishConfig": { "access": "public" },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./ranking": {
      "types": "./dist/ranking/rank.d.ts",
      "default": "./dist/ranking/rank.js"
    },
    "./conformance": {
      "types": "./dist/conformance/vitest-suite.d.ts",
      "default": "./dist/conformance/vitest-suite.js"
    }
  },
  "files": [
    "dist",
    "!dist/**/*.map"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "gen:ranking-doc": "tsx scripts/generate-ranking-doc.ts",
    "neutrality-audit": "tsx scripts/neutrality-audit.ts",
    "gen:trust-doc": "tsx scripts/generate-trust-doc.ts"
  },
  "dependencies": {
    "zod": "^4.1.5"
  },
  "peerDependencies": {
    "vitest": ">=2"
  },
  "peerDependenciesMeta": {
    "vitest": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^20.17.0",
    "tsx": "^4.23.0",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
