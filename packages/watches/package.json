{
  "name": "@northcinder/watches",
  "version": "0.1.0",
  "description": "NorthCinder price watches: standing target-price watches that NOTIFY the user and never buy — 0600 local store, crash-safe budgeted checker with persisted at-least-once dedupe, ntfy/stderr/file/webhook notifiers. Structurally checkout-free (architectural test enforced).",
  "license": "MIT",
  "type": "module",
  "engines": { "node": ">=20" },
  "keywords": ["northcinder", "price-watch", "shopping"],
  "publishConfig": { "access": "public" },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "!dist/**/*.map"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@northcinder/adapter-kit": "workspace:*",
    "@northcinder/protocol": "workspace:*",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@types/node": "^20.17.0",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
