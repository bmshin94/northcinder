{
  "name": "@northcinder/brief",
  "version": "0.2.0",
  "description": "NorthCinder buyer brief with at most three role-based default candidates, expandable finalists, provenance, rejections, unknowns, and store coverage",
  "license": "MIT",
  "type": "module",
  "engines": { "node": ">=20" },
  "keywords": ["northcinder", "shopping", "buyers-brief"],
  "publishConfig": { "access": "public" },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "!dist/**/*.map"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@northcinder/protocol": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^20.17.0",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
