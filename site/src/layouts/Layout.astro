---
import '../styles/global.css';
import { MAINTAINER } from '../site-content';

interface Props {
  title: string;
  description: string;
  schemas?: Record<string, unknown>[];
  indexable?: boolean;
  pageType?: 'website' | 'article';
  published?: string;
  modified?: string;
}

const {
  title,
  description,
  schemas = [],
  indexable = true,
  pageType = 'website',
  published,
  modified,
} = Astro.props;
const canonical = Astro.site && indexable ? new URL(Astro.url.pathname, Astro.site) : undefined;
const socialImage = Astro.site ? new URL('/social-card.png', Astro.site) : undefined;
const structuredData = canonical && schemas.length > 0
  ? JSON.stringify({ '@context': 'https://schema.org', '@graph': schemas }).replace(/</g, '\\u003c')
  : undefined;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content={MAINTAINER.name} />
    <meta name="robots" content={Astro.site && indexable ? 'index, follow' : 'noindex, nofollow'} />
    {canonical && <link rel="canonical" href={canonical} />}
    <meta property="og:type" content={pageType} />
    <meta property="og:site_name" content="NorthCinder" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {canonical && <meta property="og:url" content={canonical} />}
    {socialImage && <meta property="og:image" content={socialImage} />}
    {socialImage && <meta property="og:image:type" content="image/png" />}
    {socialImage && <meta property="og:image:width" content="1200" />}
    {socialImage && <meta property="og:image:height" content="630" />}
    {socialImage && <meta property="og:image:alt" content="NorthCinder: buyer-loyal, ad-neutral, auditable shopping" />}
    {pageType === 'article' && published && <meta property="article:published_time" content={published} />}
    {pageType === 'article' && modified && <meta property="article:modified_time" content={modified} />}
    <meta name="twitter:card" content={socialImage ? 'summary_large_image' : 'summary'} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    {socialImage && <meta name="twitter:image" content={socialImage} />}
    {socialImage && <meta name="twitter:image:alt" content="NorthCinder: buyer-loyal, ad-neutral, auditable shopping" />}
    <meta name="theme-color" content="#fbfaf7" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#151713" media="(prefers-color-scheme: dark)" />
    <link rel="icon" type="image/svg+xml" href="/mark.svg" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="alternate" type="text/plain" href="/llms.txt" title="NorthCinder for language models" />
    {structuredData && <script is:inline type="application/ld+json" set:html={structuredData} />}
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to main content</a>
    <slot />
  </body>
</html>
