---
import Mark from './Mark.astro';
import { REPO_URL } from '../consts';
---

<nav class="top" aria-label="Primary">
  <div class="wrap nav-inner">
    <a class="brand" href="/" aria-label="NorthCinder home">
      <Mark size={19} />
      <span>NorthCinder</span>
    </a>
    <div class="nav-links">
      <a href="/install/">Install</a>
      <a href="/ranking/">Ranking</a>
      <a href="/checkout-safety/">Safety</a>
      <a href="/store-coverage/">Coverage</a>
      <a href="/evidence/">Evidence</a>
      <a href="/about/">About</a>
    </div>
    {REPO_URL ? <a href={REPO_URL} class="nav-cta">
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" aria-hidden="true">
        <path
          d="M12 2C6.48 2 2 6.58 2 12.25c0 4.53 2.87 8.37 6.84 9.73.5.1.68-.22.68-.49 0-.24-.01-.87-.01-1.71-2.78.62-3.37-1.37-3.37-1.37-.45-1.18-1.11-1.49-1.11-1.49-.91-.64.07-.63.07-.63 1 .07 1.53 1.06 1.53 1.06.89 1.57 2.34 1.12 2.91.85.09-.66.35-1.12.63-1.38-2.22-.26-4.56-1.14-4.56-5.07 0-1.12.39-2.03 1.03-2.75-.1-.26-.45-1.31.1-2.72 0 0 .84-.28 2.75 1.05a9.3 9.3 0 0 1 2.5-.35c.85 0 1.71.12 2.5.35 1.91-1.33 2.75-1.05 2.75-1.05.55 1.41.2 2.46.1 2.72.64.72 1.03 1.63 1.03 2.75 0 3.94-2.34 4.8-4.57 5.06.36.32.68.94.68 1.9 0 1.37-.01 2.47-.01 2.81 0 .27.18.6.69.49A10.26 10.26 0 0 0 22 12.25C22 6.58 17.52 2 12 2Z"
          fill="currentColor"
        ></path>
      </svg>
      GitHub
    </a> : <span class="coordinate-note mono">source coordinates pending</span>}
  </div>
</nav>

<style>
  nav.top {
    border-bottom: 1px solid var(--line);
    position: sticky;
    top: 0;
    background: var(--nav-surface);
    backdrop-filter: blur(6px);
    z-index: 10;
  }
  .nav-inner { display: flex; align-items: center; justify-content: space-between; gap: 16px; padding: 12px 24px; }
  .brand { display: flex; align-items: center; gap: 8px; }
  a.brand { min-height: 44px; text-decoration: none; }
  .brand span { font-weight: 700; font-size: 15px; letter-spacing: -0.01em; }
  .nav-links { display: flex; align-items: center; flex-wrap: wrap; gap: 0 18px; font-size: 13px; font-weight: 500; color: var(--ink-2); }
  .nav-links a { display: inline-flex; align-items: center; min-height: 44px; }
  .nav-links a:hover, .nav-links a:active { color: var(--ink); }
  .nav-cta { display: inline-flex; align-items: center; gap: 6px; min-height: 44px; border: 1px solid var(--line); border-radius: 6px; padding: 8px 12px; font-size: 13px; font-weight: 600; text-decoration: none; }
  .coordinate-note { color: var(--ink-2); font-size: 12px; }
  @media (max-width: 860px) {
    .nav-inner { flex-wrap: wrap; padding-inline: 18px; }
    .nav-links { order: 3; width: 100%; }
    .coordinate-note { max-width: 17ch; text-align: right; }
  }
</style>
