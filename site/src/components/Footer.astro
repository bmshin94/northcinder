---
import { REPO_URL } from '../consts';
---

<footer>
  <div class="wrap footer-inner">
    <span>
      Open, buyer-run software with no NorthCinder-operated service. Amazon is supported only via your
      own logged-in session. See the coverage notes.
    </span>
    <div class="footer-links">
      <a href="/install/">Install</a>
      <a href="/ranking/">Ranking</a>
      <a href="/evidence/">Evidence</a>
      <a href="/about/">About</a>
      {REPO_URL ? <a href={REPO_URL}>GitHub</a> : <span class="mono">public source coordinates pending</span>}
    </div>
  </div>
</footer>

<style>
  footer { padding: 40px 0 56px; }
  .footer-inner { display: flex; align-items: center; justify-content: space-between; gap: 24px; color: var(--ink-2); font-size: 12.5px; }
  .footer-links { display: flex; flex-wrap: wrap; gap: 6px 22px; flex-shrink: 0; }
  .footer-links a { display: inline-flex; align-items: center; min-height: 44px; }

  @media (max-width: 720px) {
    .footer-inner { flex-direction: column; align-items: flex-start; }
  }
</style>
