{
  "name": "@northcinder/adapter-amazon",
  "version": "0.1.0",
  "description": "NorthCinder Amazon adapter (session-only edge, spec §3A): Playwright in the user's own browser session, honesty-gated",
  "license": "MIT",
  "type": "module",
  "engines": { "node": ">=20" },
  "keywords": ["northcinder", "amazon", "commerce", "adapter"],
  "publishConfig": { "access": "public" },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "!dist/**/*.map"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@northcinder/adapter-kit": "workspace:*",
    "@northcinder/protocol": "workspace:*",
    "playwright-core": "^1.61.1",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@types/node": "^20.17.0",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
