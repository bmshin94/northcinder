# NorthCinder environment inventory. Copy only values you need into your own shell or MCP config; never commit real values.
# Product-prefixed THENAGAIN_* and EMPTOR_* aliases remain temporary migration compatibility paths only. Canonical NORTHCINDER_* wins.

# Explicit self-hosted engine only (ordinary local mode is one process, ephemeral loopback, and keyless)
NORTHCINDER_API_KEYS=                 # required for self-hosted service: buyer-generated clientId:key pairs, keys at least 16 characters
PORT=                               # service default 8790; remote default 8791
NORTHCINDER_HOST=                   # self-hosted service bind host only; default is loopback (127.0.0.1)
SHOPIFY_MCP_SHOPS=                 # optional configured Shopify Storefront Catalog hosts (bare hostnames only; needs the UCP profile below)
SHOPIFY_UCP_AGENT_PROFILE_URL=     # required for any Shopify UCP call: HTTPS URL without userinfo to agent-profile JSON you control
SHOPIFY_GLOBAL_CATALOG_API_KEY=    # optional compatibility bearer; current Shopify catalog docs require a profile, not an API key
SHOPIFY_GLOBAL_CATALOG_MCP_URL=    # optional override; HTTPS only, with no URL credentials, query, or fragment
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
EBAY_ENV=                           # sandbox or production
EBAY_MARKETPLACE_ID=                # optional eBay marketplace header (default EBAY_US)
ETSY_API_KEY=
AMAZON_SESSION_PROFILE=             # existing read-only native Amazon adapter only; your own local browser profile
WOOCOMMERCE_STORE_HOSTS=
NORTHCINDER_DEMO_SPONSORED_ADAPTER=   # demo-only synthetic labeled offer
NORTHCINDER_TRUST_ENGINE=
NORTHCINDER_TRANCO_LIST_PATH=
NORTHCINDER_TRANCO_LIST_URL=           # commercial_clean: HTTPS only, no userinfo/query/fragment
NORTHCINDER_TRANCO_LIST_ID=            # source/list identifier recorded in trust evidence
NORTHCINDER_TRANCO_MAX_ROWS=           # bounded ingest row count
NORTHCINDER_TRUST_CORPUS_DIR=
NORTHCINDER_TRUST_SEED_PATH=
NORTHCINDER_TRUST_CT=                  # optional certificate-transparency signal
NORTHCINDER_TRUST_BUDGET_MS=           # trust-probe budget
NORTHCINDER_PHISHTANK_DUMP_PATH=       # optional local deny-grade phishing feed
NORTHCINDER_PHISHTANK_DUMP_URL=        # optional feed fetch URL
NORTHCINDER_TRUST_INGEST_INTERVAL_S=   # scheduler interval
ABUSECH_AUTH_KEY=                    # optional URLhaus evidence-feed credential; bearer secret

# MCP client runtime. The initializer writes NORTHCINDER_MODE and config; ordinary local users set none of these by hand.
NORTHCINDER_MODE=                     # local (launcher-owned engine) or self-hosted (separately operated engine)
NORTHCINDER_SERVICE_URL=              # self-hosted/remote bearer endpoint; HTTPS required except explicit loopback HTTP, with no credentials/query/fragment
NORTHCINDER_CLIENT_KEY=               # required only in self-hosted mode; bearer key matching NORTHCINDER_API_KEYS
NORTHCINDER_CONFIG_DIR=                # default: OS user config directory for northcinder
NORTHCINDER_ACP_MERCHANTS=             # JSON {"merchant-id":{"merchantDomain":"shop.example","baseUrl":"https://checkout.example/acp","apiKey":"replace-me"}}
NORTHCINDER_ACP_PAYMENT_TOKEN=         # opaque delegated token only, never card credentials
NORTHCINDER_SEARCH_TIMEOUT_MS=
NORTHCINDER_CHECKOUT_TIMEOUT_MS=
NORTHCINDER_UI=
NORTHCINDER_UI_PORT=
NORTHCINDER_UI_NTFY_TOPIC=             # bearer secret
NORTHCINDER_UI_NTFY_URL=
NORTHCINDER_MCP_SERVER_NAME=
NORTHCINDER_MCP_SERVER_VERSION=
NORTHCINDER_NTFY_TOPIC=
NORTHCINDER_NTFY_BASE_URL=
NORTHCINDER_WATCH_INTERVAL_S=

# Native store credentials above are optional and buyer-owned. Missing connections return honest
# not_configured coverage; buyer-agent browser observations need no NorthCinder browser or model credential.
# The MCP host keeps
# its own browser session and AI-provider token; never place cookies, headers, passwords, page HTML,
# screenshots, or model-provider keys in this file or an observation.

# Optional self-hosted read-only bridge; the repository owner deploys no endpoint
NORTHCINDER_REMOTE_API_KEYS=
NORTHCINDER_SERVICE_KEY=
NORTHCINDER_REMOTE_RATE_CAPACITY=
NORTHCINDER_REMOTE_RATE_REFILL_PER_SEC=
NORTHCINDER_REMOTE_MCP_SERVER_NAME=
NORTHCINDER_REMOTE_MCP_SERVER_VERSION=

# Orders IMAP is fail-closed: raw RFC 5322 headers, including Authentication-Results, never authenticate mail.
NORTHCINDER_ORDERS_IMAP_HOST=
NORTHCINDER_ORDERS_IMAP_PORT=
NORTHCINDER_ORDERS_IMAP_USER=
NORTHCINDER_ORDERS_IMAP_PASSWORD=
NORTHCINDER_ORDERS_IMAP_TOKEN=
NORTHCINDER_ORDERS_IMAP_TLS=
NORTHCINDER_ORDERS_IMAP_MAILBOX=
# Optional IMAP operation timeout in milliseconds (default 20000; max 120000); abort destroys the socket.
NORTHCINDER_ORDERS_IMAP_TIMEOUT_MS=
# Local .eml import only: set to 1 to opt in to unauthenticated drop-dir ingest (loud at runtime).
NORTHCINDER_ORDERS_ALLOW_LOCAL_UNAUTHENTICATED=
NORTHCINDER_ORDERS_MAIL_DROP_DIR=
# Popularity corpus is disabled unless explicitly classified. development_noncommercial also requires ALLOW_DEV=1.
NORTHCINDER_TRANCO_SOURCE_CLASS= # development_noncommercial or commercial_clean; blank disables Tranco
NORTHCINDER_TRANCO_ALLOW_DEV=    # required as 1 only for development_noncommercial
NORTHCINDER_ORDERS_INTERVAL_S=
NORTHCINDER_ORDERS_RETURN_REMINDER_DAYS=
# Explicit warranty/maintenance dates are recorded per order with record_order_outcome; this scheduler only sends buyer-local reminders and never takes an action.
